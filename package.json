{
  "name": "okf-playbook",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "validate": "node validate.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && pnpm --filter @okf-playbook/web typecheck",
    "retrieve": "node retrieve.ts",
    "prompt": "node prompt.ts",
    "check-answer": "node check-answer.ts",
    "compare": "node compare.ts",
    "trace": "node trace.ts",
    "graph": "node graph.ts",
    "okf:validate": "uv run -q --no-project --with pyyaml python -I .agents/skills/okf-generate/scripts/validate.py",
    "okf:scan": "uv run -q --no-project --with pyyaml python -I .agents/skills/okf-consume/scripts/scan.py",
    "okf:sync-skills": "scripts/sync-okf-skills.sh",
    "dev": "pnpm --filter @okf-playbook/web dev",
    "dev:api": "pnpm --filter @okf-playbook/server dev",
    "build:web": "pnpm --filter @okf-playbook/web build",
    "preview:web": "pnpm --filter @okf-playbook/web preview"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
