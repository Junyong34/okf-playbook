{
  "name": "okf-playbook",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "validate": "node validate.ts",
    "test": "node --test \"tests/**/*.te원st.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "retrieve": "node retrieve.ts",
    "prompt": "node prompt.ts",
    "check-answer": "node check-answer.ts",
    "compare": "node compare.ts",
    "trace": "node trace.ts",
    "graph": "node graph.ts",
    "okf:validate": "uv run -q --no-project --with pyyaml python -I .agents/skills/okf-generate/scripts/validate.py",
    "okf:scan": "uv run -q --no-project --with pyyaml python -I .agents/skills/okf-consume/scripts/scan.py",
    "okf:sync-skills": "scripts/sync-okf-skills.sh",
    "dev": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "preview:web": "vite preview --config web/vite.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@astryxdesign/core": "^0.7.16",
    "@astryxdesign/theme-neutral": "^0.7.16",
    "@heroicons/react": "^2.2.0",
    "@stylexjs/stylex": "^0.19.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.6",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.16",
    "@stylexjs/unplugin": "^0.19.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^7.0.2",
    "unplugin": "^2.3.11",
    "vite": "^7.3.8"
  },
  "browserslist": [
    "last 2 Chrome versions",
